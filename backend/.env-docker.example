# Server
PORT=3001
NODE_ENV=development
BASE_URL=http://localhost:3001

# Database
DATABASE_URL=postgres://agfinder:agfinder@postgres:5432/agfinder

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Authentication
JWT_SECRET=
JWT_ACCESS_EXPIRATION_MINUTES=30
JWT_REFRESH_EXPIRATION_DAYS=30

# Google OAuth
GOOGLE_CLIENT_ID_WEB=
GOOGLE_CLIENT_ID_ANDROID=
GOOGLE_CLIENT_ID_IOS=
GOOGLE_EXPO_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# ProxyPay
PROXYPAY_API_KEY=your-proxypay-api-key
PROXYPAY_ENTITY=12345

# Application Settings
CONTRIBUTION_EXPIRY_MINUTES=60
DAILY_RESET_TIME=00:00
BONUS_CONTRIBUTION=10
BONUS_VALIDATION=5
BONUS_WELCOME=100
BONUS_REFERRAL=50
SUBSCRIPTION_DAILY_PRICE=100
SUBSCRIPTION_WEEKLY_PRICE=600
SUBSCRIPTION_MONTHLY_PRICE=2400
BONUS_POINTS_EXCHANGE_RATE=10

# Google Maps API
GOOGLE_MAPS_API_KEY=
MAPS_API_REQUESTS_PER_DAY=25000
MAPS_API_REQUESTS_PER_MINUTE=100
MAPS_API_MAX_CONCURRENT=5
MAPS_API_RETRY_ATTEMPTS=3
MAPS_API_RETRY_DELAY=2000
MAPS_API_MAX_RETRY_DELAY=10000
MAPS_API_TIMEOUT=5000
MAPS_API_SLOW_TIMEOUT=15000

# Payment Settings
PAYMENT_DEFAULT_LIMIT=10
PAYMENT_DEFAULT_PAGE=1
PAYMENT_DEFAULT_CURRENCY=NGN
PAYMENT_RANDOM_MAX=10000
PAYMENT_RETENTION_DAYS=90

# Data Retention Settings
USER_WARNING_RETENTION_DAYS=10
BONUS_TRANSACTION_RETENTION_DAYS=90
SUBSCRIPTION_TRANSACTION_RETENTION_DAYS=90

# User Bonus Settings
BONUS_THRESHOLD_UPDATE_DAYS=7
BONUS_AWARD_COOLDOWN_DAYS=3
WELCOME_BONUS_DAYS=14

# Logging Settings
LOG_MAX_SIZE_BYTES=5242880
LOG_MAX_FILES=5

# Database Connection Pool
DB_POOL_MAX=20

# API Rate Limiting
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=100

# Pagination Settings
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100 

# Cache Settings
ENABLE_REDIS_CACHE=true
CACHE_COMPRESSION_ENABLED=true
CACHE_COMPRESSION_THRESHOLD=1024 