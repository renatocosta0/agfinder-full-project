# Server
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000

# Database
DATABASE_URL=postgres://agfinder:agfinder@localhost:5432/agfinder
# Configurações individuais (alternativa para DATABASE_URL)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=postgres
# DB_PASSWORD=postgres
# DB_NAME=agfinder

# Redis
REDIS_URL=redis://localhost:6379

# Authentication
JWT_SECRET=your-jwt-secret
JWT_ACCESS_EXPIRATION_MINUTES=30
JWT_REFRESH_EXPIRATION_DAYS=30

# Google OAuth
GOOGLE_CLIENT_ID_WEB=your_google_client_id_web
GOOGLE_CLIENT_ID_ANDROID=your_google_client_id_android
GOOGLE_CLIENT_ID_IOS=your_google_client_id_ios
GOOGLE_EXPO_CLIENT_ID=https://auth.expo.io/@username/appname
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# ProxyPay
PROXYPAY_API_KEY=your-proxypay-api-key
PROXYPAY_ENTITY=12345

# Application Settings
CONTRIBUTION_EXPIRY_MINUTES=60
DAILY_RESET_TIME=00:00
BONUS_CONTRIBUTION=10
BONUS_VALIDATION=5
BONUS_WELCOME=100
BONUS_REFERRAL=50
SUBSCRIPTION_DAILY_PRICE=100
SUBSCRIPTION_WEEKLY_PRICE=600
SUBSCRIPTION_MONTHLY_PRICE=2400
BONUS_POINTS_EXCHANGE_RATE=10

# Google Maps API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Payment Settings
PAYMENT_DEFAULT_LIMIT=10
PAYMENT_DEFAULT_PAGE=1
PAYMENT_DEFAULT_CURRENCY=NGN
PAYMENT_RANDOM_MAX=10000
PAYMENT_RETENTION_DAYS=90

# Data Retention Settings
USER_WARNING_RETENTION_DAYS=10
BONUS_TRANSACTION_RETENTION_DAYS=90
SUBSCRIPTION_TRANSACTION_RETENTION_DAYS=90

# User Bonus Settings
BONUS_THRESHOLD_UPDATE_DAYS=7
BONUS_AWARD_COOLDOWN_DAYS=3
WELCOME_BONUS_DAYS=14

# Logging Settings
LOG_MAX_SIZE_BYTES=5242880
LOG_MAX_FILES=5

# Database Connection Pool
DB_POOL_MAX=20

# API Rate Limiting
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=100

# Pagination Settings
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100 